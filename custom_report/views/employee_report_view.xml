<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_report_summary_tree" model="ir.ui.view">
        <field name="name">employee.report.summary.tree</field>
        <field name="model">employee.report.summary</field>
        <field name="arch" type="xml">
            <tree string="Employee Report">
                <field name="sequence" string="SN."/>
                <field name="employee_name" string="Employee Name"/>
                <field name="office" string="Office"/>
                <field name="hiring_date" string="Hiring Date"/>
                <field name="education" string="Education"/>
                <field name="edu_level" string="Edu Level"/>
                <field name="work_experience_tamrin" string="Work Experience at Tamrin"/>
                <field name="work_experience_before" string="Work Experience Before Tamrin"/>
                <field name="total_experience" string="Total Experience"/>
                <field name="basic_salary" string="Basic Salary"/>
            </tree>
        </field>
    </record>

    <record id="action_employee_report_summary" model="ir.actions.act_window">
        <field name="name">Employee Report</field>
        <field name="res_model">employee.report.summary</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_employee_report_summary_tree"/>
        <field name="domain">[]</field>
    </record>
</odoo>


