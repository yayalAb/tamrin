<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_purchase_report_summary_tree" model="ir.ui.view">
        <field name="name">purchase.report.summary.tree</field>
        <field name="model">purchase.report.summary</field>
        <field name="arch" type="xml">
            <tree string="Purchase Report">
                <field name="sequence" string="SN."/>
                <field name="part_number" string="Part Number (ID)"/>
                <field name="description" string="Description"/>
                <field name="uom" string="UOM"/>
                <field name="purchased_qty" string="Purchased Qty"/>
                <field name="purchase_date" string="Purchased Date"/>
                <field name="unit_price" string="Unit Price"/>
                <field name="unit_cost" string="Unit Cost"/>
            </tree>
        </field>
    </record>

    <record id="action_purchase_report_summary" model="ir.actions.act_window">
        <field name="name">Purchase Report</field>
        <field name="res_model">purchase.report.summary</field>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="view_purchase_report_summary_tree"/>
        <field name="domain">[]</field>
    </record>
</odoo>

